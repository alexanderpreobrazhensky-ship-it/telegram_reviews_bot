# Required
CLIENT_TELEGRAM_BOT_TOKEN=
BOT_PATH_SECRET=
CLIENT_WEBAPP_SESSION_SECRET=

# Runtime mode (default webhook)
CLIENT_BOT_MODE=webhook
PORT=8000

# Public URL source (priority: WEBHOOK_URL -> DOMAIN)
WEBHOOK_URL=
DOMAIN=

# WebApp
CLIENT_WEBAPP_ENABLED=1
WEBAPP_PATH=/WEBAPP
CLIENT_WEBAPP_URL=

# Masters routing
CLIENT_MASTERS_CHAT_ID=
CLIENT_MASTER_USER_IDS=
CLIENT_NOTIFY_MODE=dm_then_chat

# Storage
CLIENTS_REGISTRY_PATH=./clients.jsonl
DATABASE_URL=
