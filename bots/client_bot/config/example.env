# === Обязательные ===
# Токен клиентского бота (BotFather)
CLIENT_TELEGRAM_BOT_TOKEN=123456:ABCDEF_client_token

# Список мастеров (юзернеймы через запятую, обязательно)
MASTER_USERNAMES=@master_one,@master_two

# Список админов (tg_id через запятую, обязательно)
CLIENT_ADMIN_IDS=111111111,222222222

# === Рекомендуемые ===
# Часовой пояс
TIMEZONE=Europe/Moscow

# Период напоминаний мастеру (в минутах)
CLIENT_REMINDER_MINUTES=30

# === Опциональные (диагностика/совместимость) ===
# Список chat_id мастеров (для диагностики количества)
CLIENT_MASTER_CHAT_IDS=111111111,222222222

# Fallback токена (используется, если CLIENT_TELEGRAM_BOT_TOKEN не задан)
TELEGRAM_BOT_TOKEN_CLIENT=123456:ABCDEF_client_token_fallback

# === AI (DeepSeek) ===
# Если не заданы — бот работает в fallback режиме
CLIENT_DEEPSEEK_API_KEY=sk-example
CLIENT_DEEPSEEK_BASE_URL=https://api.deepseek.com
CLIENT_DEEPSEEK_MODEL=deepseek-chat

# Таймаут AI (сек)
CLIENT_AI_TIMEOUT_SECONDS=10

# Принудительный fallback (1 = всегда fallback)
CLIENT_FORCE_FALLBACK=0
